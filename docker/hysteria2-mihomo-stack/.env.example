TZ=Asia/Shanghai

HY2_SERVER_HOST=203.0.113.10
# A single high UDP port also works, but a range enables Hysteria 2 port hopping.
HY2_SERVER_PORTS=52120-52159
HY2_HOP_INTERVAL_SECONDS=30
HY2_STACK_SUBNET=10.254.0.0/24
HY2_STACK_GATEWAY=10.254.0.1
HY2_USERS=user01,user02,user03
HY2_PEER_DNS=1.1.1.1,8.8.8.8
HY2_MIHOMO_ROUTING_MODE=cn-direct
HY2_TLS_SERVER_NAME=203.0.113.10
HY2_TLS_SELF_SIGNED_DAYS=3650
HY2_TLS_SKIP_CERT_VERIFY=true
HY2_TLS_FINGERPRINT=
HY2_DEFAULT_DOWN=9 Mbps
HY2_DEFAULT_UP=9 Mbps
HY2_MASQUERADE_URL=https://news.ycombinator.com/
HY2_OBFS_PASSWORD=

HY2_EXPORT_SITE_ADDRESS=:8080
HY2_EXPORT_BASE_URL=http://203.0.113.10:3434
HY2_EXPORT_FALLBACK_PORT=3434
HY2_EXPORT_USER=download
# IMPORTANT:
# - Generate this with: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'YourStrongPassword'
# - In a real .env file, keep the whole bcrypt hash inside single quotes so the $ signs are not mangled:
#   HY2_EXPORT_PASSWORD_HASH='$2a$14$...'
HY2_EXPORT_PASSWORD_HASH=REPLACE_WITH_CADDY_HASH
