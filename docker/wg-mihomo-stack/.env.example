PUID=1000
PGID=1000
TZ=Asia/Shanghai

WG_SERVER_HOST=203.0.113.10
WG_SERVER_PORT=52080
# Docker bridge subnet for this stack only.
# Keep it different from:
# - OpenVPN server subnet (default: 10.8.0.0/24)
# - WireGuard client subnet below (default: 10.13.13.0/24)
# - Any existing host LAN / IDC internal route
WG_STACK_SUBNET=10.253.0.0/24
WG_STACK_GATEWAY=10.253.0.1
WG_PEERS=user01,user02,user03,user04,user05,user06,user07,user08,user09,user10
WG_PEER_DNS=1.1.1.1,8.8.8.8
WG_INTERNAL_SUBNET=10.13.13.0
WG_ALLOWEDIPS=0.0.0.0/0
WG_KEEPALIVE_PEERS=all
WG_LOG_CONFS=false

# Public ports for this stack:
# - WireGuard VPN traffic: ${WG_SERVER_PORT}/udp
# - Subscription download: 3434/tcp by default in no-domain mode
# No public Mihomo 7890 port is required on the server.

WG_EXPORT_SITE_ADDRESS=:8080
WG_EXPORT_BASE_URL=http://203.0.113.10:3434
WG_EXPORT_FALLBACK_PORT=3434
WG_EXPORT_USER=download
WG_EXPORT_PASSWORD_HASH=REPLACE_WITH_CADDY_HASH

# If you later switch to a domain + HTTPS, you will need to add
# 80/443 port mappings back into docker-compose.yml, then switch to:
# WG_EXPORT_SITE_ADDRESS=vpn.example.com
# WG_EXPORT_BASE_URL=https://vpn.example.com
