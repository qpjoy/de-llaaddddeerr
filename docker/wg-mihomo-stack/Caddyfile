{$WG_EXPORT_SITE_ADDRESS} {
	root * /srv/wg

	@health path /healthz
	respond @health 200

	@protected not path /healthz
	basic_auth @protected bcrypt {
		{$WG_EXPORT_USER} {$WG_EXPORT_PASSWORD_HASH}
	}

	header {
		Cache-Control "private, no-store"
		X-Content-Type-Options "nosniff"
	}

	file_server
}
