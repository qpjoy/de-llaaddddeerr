{
  "name": "qpjoy-electron-tunnel-npm-test",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end demo: Electron Forge app installing @qpjoy/electron-market + @qpjoy/electron-tunnel from npm.",
  "main": "src/main.cjs",
  "scripts": {
    "dev": "node scripts/dev-mode.mjs local && electron-forge start",
    "dev:npm": "node scripts/dev-mode.mjs npm && electron-forge start",
    "dev:reset": "node scripts/dev-mode.mjs npm",
    "setup": "node scripts/dev-mode.mjs local",
    "setup:npm": "node scripts/dev-mode.mjs npm",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "check": "node --check src/main.cjs && node --check src/preload.cjs && node --check src/renderer.js && node --check forge.config.cjs"
  },
  "dependencies": {
    "@qpjoy/electron-market": "file:./.local-packs/qpjoy-electron-market-0.2.1.tgz",
    "@qpjoy/electron-tunnel": "file:./.local-packs/qpjoy-electron-tunnel-0.1.4.tgz",
    "@qpjoy/plugin-sdk": "file:./.local-packs/qpjoy-plugin-sdk-0.1.0.tgz"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.1",
    "@electron-forge/maker-deb": "^7.8.1",
    "@electron-forge/maker-dmg": "^7.8.1",
    "@electron-forge/maker-zip": "^7.8.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.1",
    "electron": "^34.0.0"
  },
  "pnpm": {
    "overrides": {
      "@qpjoy/plugin-sdk": "file:./.local-packs/qpjoy-plugin-sdk-0.1.0.tgz",
      "@qpjoy/marketplace-db": "file:./.local-packs/qpjoy-marketplace-db-0.1.0.tgz",
      "@qpjoy/electron-market": "file:./.local-packs/qpjoy-electron-market-0.2.1.tgz",
      "@qpjoy/electron-tunnel": "file:./.local-packs/qpjoy-electron-tunnel-0.1.4.tgz"
    }
  }
}
