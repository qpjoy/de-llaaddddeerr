{
  "name": "@qpjoy/electron-plugins-workspace",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter @qpjoy/electron-plugin-tunnel build",
    "core:install": "node scripts/install-mihomo-core.mjs",
    "dev:quasar": "pnpm build:packages && pnpm --filter @qpjoy/tunnel-quasar-client dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
