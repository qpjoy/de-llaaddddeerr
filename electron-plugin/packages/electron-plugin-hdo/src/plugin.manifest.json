{
  "id": "qpjoy.electron-plugin-hdo",
  "name": "QPJoy HDO",
  "version": "0.2.7",
  "author": "qpjoy",
  "description": "Home-Domestic-Oversea client and server control panel for QPJoy Marketplace.",
  "engines": {
    "electronMarket": ">=0.3.0",
    "electron": ">=28"
  },
  "permissions": [
    "fs:userData",
    "net:listen:23459",
    "net:fetch:*",
    "marketplace:plugins",
    "system:exec:osascript",
    "ipc:cross",
    "ui:adminPanel"
  ],
  "activationEvents": [
    "onStartup"
  ],
  "contributes": {
    "adminPanel": {
      "url": "http://127.0.0.1:23459",
      "label": "HDO"
    }
  }
}
