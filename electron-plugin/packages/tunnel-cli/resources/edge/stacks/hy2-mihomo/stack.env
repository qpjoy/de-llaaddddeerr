# Read by qp-tunnel-cli (edge stacks / edge push) and by remote.sh preflight. KEY=value only; never sourced.
STACK_NAME=hy2-mihomo
STACK_SUMMARY="Hysteria2 server plus the Mihomo subscription site, from docker/hysteria2-mihomo-stack"
STACK_OS="debian rhel"
STACK_SYSTEMD=1
STACK_PORTS="51288/udp 3434/tcp"
STACK_STATE_REQUIRED="hy2.env"
STACK_VENDOR="docker/hysteria2-mihomo-stack/docker-compose.yml docker/hysteria2-mihomo-stack/Caddyfile docker/hysteria2-mihomo-stack/manage.sh docker/hysteria2-mihomo-stack/.env.example docker/hysteria2-mihomo-stack/scripts/reconcile-tunnel-state.mjs scripts/export-hysteria2-mihomo-stack.sh scripts/export-hysteria2-mihomo.sh"
# Pinned; docker-compose.override.yml in this directory says the same (a test checks).
STACK_IMAGES="tobyxdd/hysteria:v2.14.0 caddy:2.11.9-alpine"
STACK_INSTALLS="openssl curl; docker + compose when missing (debian: docker.io; rhel: docker-ce from EDGE_DOCKER_REPO)"
# edge stacks hy2-mihomo --init <dir> writes these, from the vendored files, next to state.example/.
STACK_STATE_TEMPLATES="hy2.env=docker/hysteria2-mihomo-stack/.env.example"
