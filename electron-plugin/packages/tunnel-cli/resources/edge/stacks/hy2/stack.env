# Read by qp-tunnel-cli (edge stacks / edge push) and by remote.sh preflight. KEY=value only; never sourced.
STACK_NAME=hy2
STACK_SUMMARY="Hysteria2 server run by the mihomo engine under systemd (no Docker); made, pushed and connected by qp-tunnel-cli hy2 up"
STACK_OS="debian rhel"
STACK_SYSTEMD=1
STACK_PORTS="HY2_PORT/udp from hy2.env (qp-tunnel-cli hy2 picks 443 when it is free)"
STACK_STATE_REQUIRED="hy2.env server.yaml tls/server.crt tls/server.key"
STACK_STATE_HINT="the state is made on the pushing machine by qp-tunnel-cli hy2 init <host> (or hy2 up <host>), not filled in by hand"
# The engine for the host's architecture is added to the bundle by qp-tunnel-cli hy2 push; a plain edge push lacks it.
STACK_BUNDLE_REQUIRED="engine/mihomo.gz engine/target"
STACK_BUNDLE_HINT="push this stack with qp-tunnel-cli hy2 push <host> (or hy2 up <host>): it adds the mihomo engine for the host's architecture"
STACK_INSTALLS="nothing: the mihomo engine ships in the bundle (from @qpjoy/electron-plugin-tunnel-engine-linux-<arch>)"
STACK_START="qp-tunnel-cli hy2 up <host>"
