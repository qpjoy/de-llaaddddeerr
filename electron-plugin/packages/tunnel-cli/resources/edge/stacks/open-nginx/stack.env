# Read by qp-tunnel-cli (edge stacks / edge push) and by remote.sh preflight. KEY=value only; never sourced.
STACK_NAME=open-nginx
STACK_SUMMARY="OpenVPN server (qp-tunnel-cli open) for the back-haul from Internal, nginx for public HTTP(S) proxied over it"
STACK_OS="debian rhel"
STACK_SYSTEMD=1
STACK_PORTS="80/tcp 443/tcp 1194/udp"
STACK_STATE_REQUIRED="edge.env nginx"
STACK_VENDOR="scripts/openvpn-server.sh"
STACK_INSTALLS="nginx curl openvpn openssl iptables (rhel: epel-release first)"
