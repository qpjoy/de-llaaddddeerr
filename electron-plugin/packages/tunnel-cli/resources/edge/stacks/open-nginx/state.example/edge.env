# open-nginx state: copy this directory, fill it in, push it with
#   qp-tunnel-cli edge push <host> --stack open-nginx --state-dir <this dir>
# It stays on the operator machine and on the host (state/<component>/, mode 600). Not in Git.

# OpenVPN server instance for the back-haul (qp-tunnel-cli open). The edge
# host has the public address; the Internal machine connects as a spoke.
EDGE_OPEN_INSTANCE=edge
# Must overlap nothing on either end. Not the Launcher's 10.88.0.0/16.
EDGE_OPEN_SUBNET=100.127.70.0/24
EDGE_OPEN_PORT=1194
EDGE_OPEN_PROTO=udp
# host (systemd unit) or docker (container mx-oversea-openvpn-<instance>).
EDGE_OPEN_RUNTIME=host
# Address spokes dial. Detected when empty.
EDGE_PUBLIC_HOST=

EDGE_HEALTH_URL=
EDGE_SELINUX_ALLOW_PROXY=0
