# wg-nginx state (optional file). It stays on the operator machine and on the
# host (state/<component>/, mode 600). Not in Git.
#
# The tunnel is not configured here. On the Internal machine run
#   qp-tunnel-cli edge link init <host>        (asks for the subnet and the rest; or qp-tunnel-cli edge setup)
# which writes wg/relay.conf and wg/relay.env next to this file (keys made on
# that machine), then
#   qp-tunnel-cli edge push <host> --stack wg-nginx
# nginx sites go in nginx/<name>.conf; without any, only the tunnel is set up.

# Optional: a URL health.sh fetches after each push (anything below 500 passes).
EDGE_HEALTH_URL=

# CentOS/Rocky with SELinux enforcing: nginx cannot proxy until
# httpd_can_network_connect is on. 1 lets deploy.sh run setsebool -P; 0 only warns.
EDGE_SELINUX_ALLOW_PROXY=0
