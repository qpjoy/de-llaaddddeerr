# Read by qp-tunnel-cli (edge stacks / edge push) and by remote.sh preflight. KEY=value only; never sourced.
STACK_NAME=wg-nginx
STACK_SUMMARY="WireGuard relay the Internal side dials out to (the shape of the Launcher's mx-domestic), nginx sites proxied over it (optional)"
STACK_OS="debian rhel"
STACK_SYSTEMD=1
STACK_PORTS="51820/udp 80/tcp 443/tcp"
STACK_STATE_REQUIRED="wg/relay.conf wg/relay.env"
STACK_STATE_HINT="wg/ comes from the Internal machine: qp-tunnel-cli edge link init <host> (asks for the subnet; or the whole way: qp-tunnel-cli edge setup)"
STACK_INSTALLS="wireguard-tools; nginx curl only when there are nginx/*.conf sites (rhel: epel-release first)"
