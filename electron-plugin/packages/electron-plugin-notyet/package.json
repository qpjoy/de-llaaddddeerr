{
  "name": "@qpjoy/electron-plugin-notyet",
  "version": "0.1.5",
  "description": "NotYet floating consultation ball for QPJoy marketplace. Renders a 古风 + 科技 3D-style action ball on every host window with one-tap access to https://www.notyet.chat and a cover-not-replace navigation model (return preserves underlying app state).",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["README.md", "dist"],
  "qpjoyPlugin": {
    "specVersion": 1,
    "entry": "dist/plugin.js",
    "manifest": "dist/plugin.manifest.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": ["electron", "plugin", "qpjoy", "notyet", "overlay", "ball", "chat"],
  "homepage": "https://www.notyet.chat",
  "peerDependencies": {
    "electron": ">=28"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "electron": "^34.0.0",
    "typescript": "^5.7.3"
  }
}
