# QPJoy electron-server example environment.
# Copy to .env on the deployment host and replace every "change-me" value.
#
#   cp .env.example .env
#   ./scripts/manage.sh redeploy

# Public marketplace / HDO control-plane port exposed by docker-compose.
MARKET_PORT=8080

# Postgres container settings.
PG_USER=qpjoy
PG_PASSWORD=change-me-postgres-password
PG_DB=qpjoy_market

# Keep Postgres bound to localhost on the host. Use "5433" only if you
# deliberately want to expose it on all host interfaces.
PG_PORT=127.0.0.1:5433
PG_POOL_MAX=8

# Required in production. Generate with:
#   openssl rand -base64 48
JWT_SECRET=change-me-long-random-secret
# Desktop plugin sessions should survive normal admin usage without frequent
# re-login. Defaults: access token 7 days, refresh token 30 days.
JWT_ACCESS_TTL_SECONDS=604800
JWT_REFRESH_TTL_SECONDS=2592000

NODE_ENV=production
LOG_LEVEL=info

# npm sync source. HDO is included explicitly so a freshly published package
# can be synced without waiting for npm search indexing.
NPM_REGISTRY=https://registry.npmjs.org
NPM_SCOPE=@qpjoy
NPM_PREFIX=electron-
MARKETPLACE_ALLOWLIST=@qpjoy/electron-plugin-tunnel,@qpjoy/electron-plugin-notyet,@qpjoy/electron-game-suduku,@qpjoy/electron-plugin-hdo

# Account verification is deferred unless a real email/SMS provider is wired.
REQUIRE_VERIFICATION=0

# In-container npm sync scheduler.
SYNC_ENABLED=1
SYNC_ON_BOOT=1
SYNC_INTERVAL_MS=3600000
SYNC_JITTER_MS=30000
