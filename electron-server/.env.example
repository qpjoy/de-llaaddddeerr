# QPJoy electron-server example environment.
# Copy to .env on the deployment host and replace every "change-me" value.
#
#   cp .env.example .env
#   ./scripts/manage.sh redeploy

# Public marketplace / HDO control-plane port exposed by docker-compose.
MARKET_PORT=8080

# HDO control-plane URLs used by gateway scripts.
#
# HDO_SERVER_URL is the base URL that server-side code advertises by default.
# HDO_GATEWAY_SERVER_URL is the URL used by the host gateway runner when it
# calls electron-server from the deployment host. Keep these aligned with
# MARKET_PORT unless you put a reverse proxy in front of the server.
#
# Examples:
#   direct : MARKET_PORT=8080, URLs=http://127.0.0.1:8080
#   nginx  : MARKET_PORT=8080, public URL=http://your-domain or http://your-ip
HDO_SERVER_URL=http://127.0.0.1:8080
HDO_GATEWAY_SERVER_URL=http://127.0.0.1:8080

# HDO host runner.
#
# electron-server runs in Docker and calls this runner through
# host.docker.internal. Therefore the host runner must not bind only to
# 127.0.0.1; use 0.0.0.0 or a Docker-bridge-reachable host address.
#
# Port 18081 is a private host/Docker control port. Do not open it in the
# cloud security group; only MARKET_PORT and WireGuard UDP ports should be
# public when needed.
HDO_GATEWAY_RUNNER_HOST=0.0.0.0
HDO_GATEWAY_RUNNER_PORT=18081
HDO_GATEWAY_RUNNER_URL=http://host.docker.internal:18081
HDO_GATEWAY_RUNNER_TOKEN=change-me-runner-token
HDO_AUTO_SYNC_DOMESTIC=true

# Postgres container settings.
PG_USER=qpjoy
PG_PASSWORD=change-me-postgres-password
PG_DB=qpjoy_market

# Keep Postgres bound to localhost on the host. Use "5433" only if you
# deliberately want to expose it on all host interfaces.
PG_PORT=127.0.0.1:5433
PG_POOL_MAX=8

# Required in production. Generate with:
#   openssl rand -base64 48
JWT_SECRET=change-me-long-random-secret
# Desktop plugin sessions should survive normal admin usage without frequent
# re-login. Defaults: access token 7 days, refresh token 30 days.
JWT_ACCESS_TTL_SECONDS=604800
JWT_REFRESH_TTL_SECONDS=2592000

NODE_ENV=production
LOG_LEVEL=info

# npm sync source. HDO is included explicitly so a freshly published package
# can be synced without waiting for npm search indexing.
NPM_REGISTRY=https://registry.npmjs.org
NPM_SCOPE=@qpjoy
NPM_PREFIX=electron-
MARKETPLACE_ALLOWLIST=@qpjoy/electron-plugin-tunnel,@qpjoy/electron-plugin-notyet,@qpjoy/electron-game-suduku,@qpjoy/electron-plugin-hdo

# Account verification is deferred unless a real email/SMS provider is wired.
REQUIRE_VERIFICATION=0

# In-container npm sync scheduler.
SYNC_ENABLED=1
SYNC_ON_BOOT=1
SYNC_INTERVAL_MS=3600000
SYNC_JITTER_MS=30000
