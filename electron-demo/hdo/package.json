{
  "name": "qpjoy-hdo-client",
  "productName": "MX HDO",
  "version": "0.1.0",
  "private": true,
  "author": "QPJoy",
  "description": "MX HDO desktop client.",
  "main": "src/main.cjs",
  "scripts": {
    "dev": "node scripts/dev-mode.mjs local && electron-builder install-app-deps && electron .",
    "dev:npm": "node scripts/dev-mode.mjs npm && electron-builder install-app-deps && electron .",
    "dev:reset": "node scripts/dev-mode.mjs npm",
    "start": "pnpm dev",
    "setup": "node scripts/dev-mode.mjs local",
    "setup:npm": "node scripts/dev-mode.mjs npm",
    "package": "node scripts/dev-mode.mjs npm && electron-builder --config electron-builder.config.cjs --dir",
    "make": "node scripts/dev-mode.mjs npm && electron-builder --config electron-builder.config.cjs",
    "make:mac": "node scripts/dev-mode.mjs npm && electron-builder --config electron-builder.config.cjs --mac --universal",
    "make:mac:dmg": "node scripts/dev-mode.mjs npm && electron-builder --config electron-builder.config.cjs --mac dmg --universal",
    "make:win": "node scripts/dev-mode.mjs npm && electron-builder --config electron-builder.config.cjs --win --x64",
    "check": "node --check src/main.cjs && node --check src/preload.cjs && node --check src/renderer.js && node --check electron-builder.config.cjs",
    "build:local": "pnpm --dir ../../electron-market build && pnpm --dir ../../electron-plugin build:packages"
  },
  "dependencies": {
    "@qpjoy/electron-market": "^0.4.2",
    "@qpjoy/electron-launcher": "^0.1.0",
    "@qpjoy/electron-plugin-hdo": "^1.0.0",
    "@qpjoy/electron-plugin-sdk": "^0.1.4",
    "@qpjoy/electron-plugin-tunnel": "^0.1.17"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron"
    ],
    "overrides": {
      "@qpjoy/electron-plugin-sdk": "file:./.local-packs/qpjoy-electron-plugin-sdk-0.1.4.tgz",
      "@qpjoy/marketplace-db": "file:./.local-packs/qpjoy-marketplace-db-0.1.1.tgz",
      "@qpjoy/electron-market": "file:./.local-packs/qpjoy-electron-market-0.4.2.tgz",
      "@qpjoy/mx-launcher-core": "file:./.local-packs/qpjoy-mx-launcher-core-0.1.0.tgz",
      "@qpjoy/mx-launcher-embed-sdk": "file:./.local-packs/qpjoy-mx-launcher-embed-sdk-0.1.0.tgz",
      "@qpjoy/mx-launcher-standalone": "file:./.local-packs/qpjoy-mx-launcher-standalone-0.1.0.tgz",
      "@qpjoy/electron-launcher": "file:./.local-packs/qpjoy-electron-launcher-0.1.0.tgz",
      "@qpjoy/electron-core-wireguard-engine-darwin-arm64": "file:./.local-packs/qpjoy-electron-core-wireguard-engine-darwin-arm64-0.1.2.tgz",
      "@qpjoy/electron-core-wireguard-engine-darwin-x64": "file:./.local-packs/qpjoy-electron-core-wireguard-engine-darwin-x64-0.1.2.tgz",
      "@qpjoy/electron-core-wireguard-engine-linux-arm64": "file:./.local-packs/qpjoy-electron-core-wireguard-engine-linux-arm64-0.1.2.tgz",
      "@qpjoy/electron-core-wireguard-engine-linux-x64": "file:./.local-packs/qpjoy-electron-core-wireguard-engine-linux-x64-0.1.2.tgz",
      "@qpjoy/electron-core-wireguard-engine-win32-x64": "file:./.local-packs/qpjoy-electron-core-wireguard-engine-win32-x64-0.1.2.tgz",
      "@qpjoy/electron-core-wireguard": "file:./.local-packs/qpjoy-electron-core-wireguard-0.2.1.tgz",
      "@qpjoy/electron-plugin-hdo": "file:./.local-packs/qpjoy-electron-plugin-hdo-1.0.0.tgz"
    }
  }
}
