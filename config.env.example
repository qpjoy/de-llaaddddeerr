# de-llaaddddeerr 配置文件
# 复制此文件为 config.env 并修改为你的实际配置
# cp config.env.example config.env

# ============ VPN 服务器 ============
# OpenVPN 服务器 IP（公司 VPN）
OPENVPN_SERVER="x.x.x.x"

# WireGuard VPS IP（个人服务器）
VPS_IP="x.x.x.x"

# ============ 内网网段 ============
# WireGuard 网关
WG_GATEWAY="10.7.0.1"

# OpenVPN 分配的 IP 网段前缀（用于接口检测）
OPENVPN_SUBNET="10.0.70"

# WireGuard 分配的 IP 网段前缀（用于接口检测）
WG_SUBNET="10.7.0"

# ============ 本地网络 ============
# 家庭 Wi-Fi 网段（会优先走本地网关）
HOME_NETWORK="192.168.1.0/24"
