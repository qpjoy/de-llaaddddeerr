{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-jsx",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "react", "react-dom"]
  },
  "include": [
    "agent-market/**/*.ts",
    "server/agent-market/**/*.ts",
    "server/agent-studio/**/*.ts",
    "src/pages-agent-market.tsx",
    "src/pages-agent-center.tsx",
    "src/pages-agent-studio.tsx"
  ]
}
