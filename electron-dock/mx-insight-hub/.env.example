# Local Docker Compose defaults. Copy to .env only when overriding them.
MX_INSIGHT_ADMIN_TOKEN=local-admin-change-me
MX_INSIGHT_API_KEY_PEPPER=local-pepper-change-me-at-least-32-bytes
MX_INSIGHT_POSTGRES_PASSWORD=local-postgres-change-me
MX_INSIGHT_RESERVATION_LEASE_MS=150000
# Public/combined paid-provider gates require durable PostgreSQL storage.
# Memory storage is supported only for tests and gates-off local development.

# Browser-reachable Public API origin. The authenticated Admin session returns
# this non-secret routing value; use it when Admin and Public have different
# hosts or TLS origins. Combined/same-origin mode may leave it empty.
# MX_INSIGHT_PUBLIC_URL=https://hub.example.com

# Compatibility-only Admin-SPA build-time fallbacks. Direct production visits
# to :18151 can also use the same host on :18150.
# VITE_MX_INSIGHT_PUBLIC_API_BASE=https://hub.example.com
# VITE_MX_INSIGHT_PUBLIC_DOCS_URL=https://hub.example.com/docs

# Night-All remains private. For local Docker this reaches the host installation.
NIGHT_ALL_BASE_URL=http://host.docker.internal:18141
NIGHT_ALL_TIMEOUT_MS=30000
NIGHT_ALL_READY_MODE=ready_only
NIGHT_ALL_SERVICE_TOKEN=

# Optional paid external-data connector. Prefer saving its key through the
# Admin UI/database. This environment fallback is never accepted from a public
# request. Omit or leave blank on routine Internal K8s deploys to retain the
# current value. Clearing it requires the one-shot deploy flag documented below.
# MX_INSIGHT_JUSTONE_TOKEN=
# Never persist this destructive flag in an env file. To remove a retained
# environment fallback once, prefix the deploy command with:
# MX_INSIGHT_CLEAR_JUSTONE_ENV_TOKEN=1
# Independent release gate. Saving a key in the UI does not open it. Omit it on
# routine Internal K8s deploys to retain the current value; explicitly set 0 to
# stop all new dispatches or 1 after the pinned contract fixtures are reviewed.
# MX_INSIGHT_JUSTONE_CONTRACT_VERIFIED=0
MX_INSIGHT_JUSTONE_TIMEOUT_MS=120000
MX_INSIGHT_JUSTONE_FRESH_TTL_MS=60000
MX_INSIGHT_JUSTONE_STALE_TTL_MS=604800000
MX_INSIGHT_JUSTONE_UNKNOWN_FINGERPRINT_COOLDOWN_MS=900000
MX_INSIGHT_JUSTONE_MAX_CONCURRENCY=32
MX_INSIGHT_JUSTONE_MAX_CONSUMER_CONCURRENCY=8
# Global RPM is enforced by one PostgreSQL token bucket shared across Hub Pods.
MX_INSIGHT_JUSTONE_MAX_REQUESTS_PER_MINUTE=90
MX_INSIGHT_JUSTONE_CIRCUIT_FAILURES=3
MX_INSIGHT_JUSTONE_CIRCUIT_OPEN_MS=60000
# Prices/free quota are not exposed by a verified provider API today. Configure
# only a reviewed, date-stamped pricebook; absent values remain unknown, not 0.
# Both monthly fields may be 0: that closes unpriced/subsidized traffic, while a
# request with its own positive enforced wallet hold treats them as warning-only.
# Provider rate/quota/concurrency/circuit and current-request cost evidence remain.
# MX_INSIGHT_JUSTONE_BILLING_JSON='{"source":"manual","currency":"CNY","pricingAsOf":"2026-09-03T00:00:00Z","freeDailyCalls":0,"monthlyBudgetMinor":0,"monthlySubsidyBudgetMinor":0,"unitCostMinorByEndpoint":{"jd.product-search.v1":5}}'

# Direct TikHub connector for the Hub-owned Xiaohongshu note API. Prefer the
# Admin credential center. The environment fallback and independent contract
# gate follow the same retain-on-deploy rules as JustOne.
# MX_INSIGHT_TIKHUB_API_KEY=
# MX_INSIGHT_CLEAR_TIKHUB_ENV_KEY=1
# MX_INSIGHT_TIKHUB_CONTRACT_VERIFIED=0
# Keep search cutover off until every public-api pod runs the direct-search code.
# MX_INSIGHT_TIKHUB_SEARCH_CONTRACT_VERIFIED=0
# Keep crawl/user-info and provider-shaped user APIs off until their complete
# multi-call contract, cost controls and exact-response archive are deployed.
# MX_INSIGHT_TIKHUB_USER_ACTIVITY_CONTRACT_VERIFIED=0
# Optional comma-separated consumer UUID allowlist for new direct searches and
# capability advertisement. Empty/unset preserves the existing global gate;
# direct continuation cursors remain pinned during canary changes or rollback.
# MX_INSIGHT_TIKHUB_SEARCH_CANARY_CONSUMER_IDS=
# Mainland China should use the official acceleration origin; other regions
# should retain api.tikhub.io. Arbitrary origins are rejected before startup.
MX_INSIGHT_TIKHUB_BASE_URL=https://api.tikhub.dev
MX_INSIGHT_TIKHUB_TIMEOUT_MS=30000
MX_INSIGHT_TIKHUB_FRESH_TTL_MS=86400000
MX_INSIGHT_TIKHUB_STALE_TTL_MS=2592000000
MX_INSIGHT_TIKHUB_SEARCH_FRESH_TTL_MS=300000
MX_INSIGHT_TIKHUB_SEARCH_STALE_TTL_MS=86400000
# Repair every known 60-character preview in one 20-item search page. Provider
# RPM, global concurrency, two detail workers and the request deadline still
# bound upstream load; lower this only as an explicit data-quality tradeoff.
MX_INSIGHT_TIKHUB_SEARCH_MAX_ENRICH_ITEMS=20
MX_INSIGHT_TIKHUB_SEARCH_ENRICH_CONCURRENCY=2
MX_INSIGHT_TIKHUB_UNKNOWN_FINGERPRINT_COOLDOWN_MS=900000
# Keep this at or below the provider account's verified RPS/concurrency tier.
MX_INSIGHT_TIKHUB_MAX_CONCURRENCY=8
MX_INSIGHT_TIKHUB_MAX_CONSUMER_CONCURRENCY=8
# Global RPM is enforced by one PostgreSQL token bucket shared across Hub Pods.
MX_INSIGHT_TIKHUB_MAX_REQUESTS_PER_MINUTE=120
MX_INSIGHT_TIKHUB_CIRCUIT_FAILURES=3
MX_INSIGHT_TIKHUB_CIRCUIT_OPEN_MS=60000
# Example only; use the reviewed provider price and date for the real account.
# Both monthly fields may be 0. Paid-ready downstream requests continue while
# unpriced/subsidized traffic remains closed; record every real provider call.
# MX_INSIGHT_TIKHUB_BILLING_JSON='{"source":"manual","currency":"USD","pricingAsOf":"2026-09-07T00:00:00Z","unitCostMinor":1,"monthlyBudgetMinor":0,"monthlySubsidyBudgetMinor":0}'

# Authenticated image relay. One product page may fetch all nine images in
# parallel; the server coalesces identical requests and keeps a bounded cache.
MX_INSIGHT_EXTERNAL_MEDIA_MAX_REQUESTS=1200
MX_INSIGHT_EXTERNAL_MEDIA_WINDOW_MS=60000
MX_INSIGHT_EXTERNAL_MEDIA_CONSUMER_CONCURRENCY=16
MX_INSIGHT_EXTERNAL_MEDIA_GLOBAL_CONCURRENCY=32
MX_INSIGHT_EXTERNAL_MEDIA_CACHE_BYTES=134217728
MX_INSIGHT_EXTERNAL_MEDIA_CACHE_ENTRIES=2048
MX_INSIGHT_EXTERNAL_MEDIA_CACHE_TTL_MS=3600000

# Legacy compatibility only. New PostgreSQL sources, including their connection
# credentials, are registered directly through the Admin-token-only data-source
# API/UI and take effect without a deployment.
MX_INSIGHT_TG_MONITOR_DATABASE_URL=
MX_INSIGHT_EXTERNAL_PULL_INTERVAL_MS=60000
MX_INSIGHT_EXTERNAL_PULL_BATCH_SIZE=1000
# Durable delay between Telegram SQLite pages. This paces a full import without
# holding the ingest worker; 0 disables it, maximum 60000.
MX_INSIGHT_TELEGRAM_SQLITE_PAGE_DELAY_MS=1000
# Fixed nationwide province source: process at most one 200-row page at a time
# and leave a durable pause before the continuation. 0 disables the pause.
MX_INSIGHT_PROVINCE_PAGE_DELAY_MS=2000
# Province pipeline activation is fail-closed unless both are configured. The
# projector still retries/backoffs on a transient HanLP outage; it never writes
# Jieba/bigram tokens for this corpus.
MX_COMMON_SEGMENTER=hanlp
MX_COMMON_HANLP_URL=

# Optional OpenAI-compatible chat chain, in priority order. The Admin Agent
# center can instead persist providers and credentials in PostgreSQL without a
# restart. DeepSeek and third-party OpenAI-compatible URLs use the same shape.
# MX_INSIGHT_AGENT_PROVIDERS='[{"id":"deepseek","baseUrl":"https://api.deepseek.com/v1","model":"deepseek-chat","apiKeyEnv":"DEEPSEEK_API_KEY"}]'
# Existing environment/K8s Provider definitions and their referenced keys are
# imported once into PostgreSQL on startup. Set 0 only for emergency rollback.
MX_INSIGHT_AGENT_AUTO_MIGRATE=1
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# Optional, deployment-owned server-file allowlist. Pasted absolute paths must
# resolve below one of these roots; the Hub persists only rootId + relativePath.
# Server paths are accepted only under these static read-only roots. The
# production manifest mounts host /shared_dir at the same container path.
MX_INSIGHT_SERVER_FILE_ROOTS='{"shared-dir":"/shared_dir"}'
# Local Compose can bind a different host directory to container /shared_dir.
# MX_INSIGHT_SERVER_FILE_HOST_PATH=/shared_dir
# Numeric read-only group that may traverse the mounted directory. Internal
# production uses the host `wheel` GID 10 and never chmods/chowns source files.
# MX_INSIGHT_SERVER_FILE_GROUP_ID=10

# Internal Kubernetes deployment inputs.
MX_INSIGHT_IMAGE=mx-insight-hub:shadow
# The internal k8s deploy runs the API pods with a hostNetwork overlay, so when
# NIGHT_ALL_BASE_URL is unset it defaults to the host-local http://127.0.0.1:13141.
# Explicit grants are idempotently reconciled on every deploy, including key reuse.
# An empty value never auto-grants newly added Hub-local platforms.
# MX_INSIGHT_BOOTSTRAP_PLATFORMS=xiaohongshu,douyin,telegram
# A Xiaohongshu platform scope automatically requires social.posts.resolve.
# Add other operation scopes explicitly; these are snapshotted into new keys.
# MX_INSIGHT_BOOTSTRAP_CAPABILITIES=nlp.tokenize
# Existing bootstrap consumers are CAS-reconciled to this active published plan
# before a Xiaohongshu-capable key is minted. Failure blocks key issuance.
# MX_INSIGHT_BOOTSTRAP_PLAN_KEY=launch-1m
