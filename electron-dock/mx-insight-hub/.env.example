# Local Docker Compose defaults. Copy to .env only when overriding them.
MX_INSIGHT_ADMIN_TOKEN=local-admin-change-me
MX_INSIGHT_API_KEY_PEPPER=local-pepper-change-me-at-least-32-bytes
MX_INSIGHT_POSTGRES_PASSWORD=local-postgres-change-me

# Night-All remains private. For local Docker this reaches the host installation.
NIGHT_ALL_BASE_URL=http://host.docker.internal:18141
NIGHT_ALL_TIMEOUT_MS=30000
NIGHT_ALL_READY_MODE=ready_only
NIGHT_ALL_SERVICE_TOKEN=

# Legacy compatibility only. New PostgreSQL sources, including their connection
# credentials, are registered directly through the Admin-token-only data-source
# API/UI and take effect without a deployment.
MX_INSIGHT_TG_MONITOR_DATABASE_URL=
MX_INSIGHT_EXTERNAL_PULL_INTERVAL_MS=60000
MX_INSIGHT_EXTERNAL_PULL_BATCH_SIZE=1000

# Internal Kubernetes deployment inputs.
MX_INSIGHT_IMAGE=mx-insight-hub:shadow
# The internal k8s deploy runs the API pods with a hostNetwork overlay, so when
# NIGHT_ALL_BASE_URL is unset it defaults to the host-local http://127.0.0.1:13141.
# Explicit grants are idempotently reconciled on every deploy, including key reuse.
# An empty value never auto-grants newly added Hub-local platforms.
# MX_INSIGHT_BOOTSTRAP_PLATFORMS=xiaohongshu,douyin,telegram
