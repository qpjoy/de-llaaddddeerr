# Local Docker Compose defaults. Copy to .env only when overriding them.
MX_INSIGHT_ADMIN_TOKEN=local-admin-change-me
MX_INSIGHT_API_KEY_PEPPER=local-pepper-change-me-at-least-32-bytes
MX_INSIGHT_POSTGRES_PASSWORD=local-postgres-change-me

# Night-All remains private. For local Docker this reaches the host installation.
NIGHT_ALL_BASE_URL=http://host.docker.internal:18141
NIGHT_ALL_TIMEOUT_MS=30000
NIGHT_ALL_READY_MODE=ready_only
NIGHT_ALL_SERVICE_TOKEN=

# Internal Kubernetes deployment inputs.
MX_INSIGHT_IMAGE=mx-insight-hub:shadow
