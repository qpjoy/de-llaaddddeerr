# Keep Elasticsearch and Kibana on exactly the same version. This local sample
# tracks a current 9.x line and is not an instruction to attach an old 8.13.4
# data volume or install the legacy HanLP Elasticsearch plugin.
ELASTIC_VERSION=9.4.2
ELASTICSEARCH_HEAP=1g
MX_INSIGHT_ELASTICSEARCH_PORT=19200
MX_INSIGHT_KIBANA_PORT=15601
TZ=Asia/Shanghai
