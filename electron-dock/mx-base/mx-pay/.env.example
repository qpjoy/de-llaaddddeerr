# Optional overrides only. Fresh Kubernetes install: bash scripts/manage.sh deploy
# Context: retained target -> current-context -> sole context; never use-context.
# MX_PAY_KUBE_CONTEXT=your-internal-context
# MX_PAY_NAMESPACE=mx-pay
# Existing registry from .env or same-namespace ConfigMap/mx-platform-runtime
# (data.imageRepository). Otherwise auto-import to EVERY worker via local ctr /
# existing trusted SSH; no runtime configuration changes or new SSH host keys.
# MX_PAY_IMAGE_REPOSITORY=registry.example.com/mx/mx-pay
# MX_PAY_BUILD=1
# Prebuilt alternative: MX_PAY_BUILD=0 and MX_PAY_IMAGE=registry/...@sha256:<digest>
# MX_PAY_REPLICAS=2
# MX_PAY_MIN_READY_WORKERS=2
# Dedicated PG16, owner/runtime roles and app credentials are automatically created.
# Existing files and retained cluster credentials take precedence; never rotated.
# MX_PAY_RUNTIME_ENV_FILE=secrets/runtime.env
# MX_PAY_MIGRATION_ENV_FILE=secrets/migration.env
# MX_PAY_CREDENTIALS_SOURCE=secrets/credentials.json
# MX_PAY_CHANNELS_SOURCE=secrets/channels.json
# Defaults to [] (automatic channels disabled). See docs/alipay-channels.md.
# Alipay private keys belong only in this private file/immutable Secret, never in Hub or browser config.
# Auto storage: unique default StorageClass; otherwise a local PV on this Linux
# node, fixed to mounted /data/mx-pay/<namespace>/postgres or /var/lib/mx-pay/... .
# /data present but not mounted is an ERROR, not permission to use another disk.
# MX_PAY_STORAGE_CLASS=your-retained-storage
# MX_PAY_PG_DATA_PATH=/data/mx-pay/mx-pay/postgres
# MX_PAY_POSTGRES_IMAGE=postgres:16-bookworm
# Backup defaults to /var/backups/mx-pay/<namespace> on Linux; copy off-host securely.
# MX_PAY_BACKUP_DIR=/your-mounted-backup-volume/mx-pay
# For an existing external dedicated PG, create runtime.env/migration.env with
# MX_PAY_DATABASE_URL=postgresql://.../mx_pay and MX_PAY_RUNTIME_ROLE in migration.env.
# That database is not automatically provisioned, reset or backed up by this script.
# Optional private registry Secret (already provisioned in this namespace).
# MX_PAY_IMAGE_PULL_SECRET=mx-pay-registry

# Development/transition only: set driver=compose and use an existing dedicated PG endpoint.
# The credentials file and runtime.env above are also used by Compose.
# MX_PAY_DEPLOY_DRIVER=compose
# MX_PAY_BIND=127.0.0.1
# MX_PAY_PORT=18230

# Optional independent human console (default port 18231); API never depends on SSO.
# Register mx-pay in Internal > unified identity > applications, then provide its
# persistent private profile and explicit viewer access. Both absent => API only.
# MX_PAY_SSO_SOURCE=secrets/console/profile.json
# MX_PAY_CONSOLE_ACCESS_SOURCE=secrets/console/access.json
# MX_PAY_CONSOLE_PORT=18231 # Compose host bind only; Kubernetes Service uses 18231
# See docs/sso-and-application-onboarding.md for TLS routing and least-scope access.
