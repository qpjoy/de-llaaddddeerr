# Application schema tunables have types, ranges and fallback defaults.
# Shell syntax, Compose interpolation, ports, paths/permissions, filesystem
# types and credentials can still prevent deployment or service startup.
#
# Settings marked adjustable can also be changed at runtime from
# http://<bind>:<writer port>/static/admin without a redeploy.

MX_STATIC_DATA_PATH=/srv/mx-static/data
MX_STATIC_UID=1000
MX_STATIC_GID=1000
MX_STATIC_BIND_IP=127.0.0.1
MX_STATIC_PUBLIC_URL=https://hub.minsight-ai.com
MX_STATIC_CORS_ORIGINS=

# Control queue and core data MUST remain on local disk. NAS is archive-only.
MX_STATIC_STATE_PATH=/srv/mx-static/state
MX_STATIC_WORKERS=4
MX_STATIC_MAX_QUEUED=10000
MX_STATIC_CACHE_BYTES=67108864
MX_STATIC_CACHE_TTL_MS=60000
# Core DATA_PATH and STATE_PATH MUST stay local. Optional independent NAS attachment:
# MX_STATIC_NAS_PATH=/mnt/nas/mx-static
# MX_STATIC_NAS_VOLUME_ID=mx-static-nas-01
# Create .mx-static-volume-id with this exact value ON the confirmed mounted NFS.

# Capacity is declared as a service level; admission permits are derived from it
# and reported live at GET /static/v1/projects/<p>/capacity. See docs/capacity.md.
MX_STATIC_SLO_ASSET_QPS=10            # sustained image/static reads per second
MX_STATIC_SLO_ASSET_P95_MS=200        # latency budget for that class
MX_STATIC_SLO_VIDEO_VIEWERS=30        # concurrent video/audio streams
MX_STATIC_SLO_VIDEO_BITRATE_KBPS=3000
# Measure these two rather than guessing: iperf3 for the link, fio for the disk.
MX_STATIC_LINK_MBPS=1000
MX_STATIC_DISK_READ_MBPS=500
# Warn when the declared service level does not fit the declared hardware; set
# true to refuse to start instead.
MX_STATIC_CAPACITY_STRICT=false
# Above this smoothed event-loop delay the video class sheds first, so the asset
# promise survives a busy process.
MX_STATIC_MAX_LAG_MS=250
# Explicit overrides; leave unset to use the values derived from the SLO.
# MX_STATIC_MAX_READS=
# MX_STATIC_MAX_ASSET_STREAMS=
# MX_STATIC_MAX_VIDEO_STREAMS=
# Browser cache window for immutable objects; capped by the signature's own
# remaining lifetime, so key rotation still revokes within that window.
MX_STATIC_FILE_MAX_AGE=900
# Upper bound for POST .../ingest/batch, which accepts a whole upstream page in
# one durable transaction.
MX_STATIC_MAX_BATCH=200
# Every fs call and dns.lookup shares libuv's pool; the Node default of 4 lets a
# few video streams stall every manifest read behind them.
MX_STATIC_THREADPOOL=16

# Archive to NAS. Concurrency lives inside the single archive child, never as
# more processes: measure with scripts/nas-bench.mjs before changing it.
MX_STATIC_NAS_CONCURRENCY=4
# always | sample | never -- the far-side read-back after each write, which
# doubles NFS traffic to catch corruption on the NAS. Eviction always verifies,
# whatever this says: it is the one operation that deletes the other copy.
MX_STATIC_NAS_VERIFY=always

# Let nginx send the object bytes instead of this service. Point it at the
# `internal` location in deploy/internal-locations.conf; empty means this
# service streams them itself. Authorisation and cold-file recovery still
# happen here either way.
# MX_STATIC_ACCEL_REDIRECT=/internal-objects
