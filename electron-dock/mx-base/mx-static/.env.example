MX_STATIC_DATA_PATH=/srv/mx-static/data
MX_STATIC_UID=1000
MX_STATIC_GID=1000
MX_STATIC_BIND_IP=127.0.0.1
MX_STATIC_PUBLIC_URL=https://hub.minsight-ai.com
MX_STATIC_CORS_ORIGINS=

# Control queue MUST remain on local disk, including after data moves to NAS.
MX_STATIC_STATE_PATH=/srv/mx-static/state
MX_STATIC_WORKERS=4
MX_STATIC_MAX_QUEUED=10000
MX_STATIC_CACHE_BYTES=67108864
MX_STATIC_CACHE_TTL_MS=60000
# Core DATA_PATH and STATE_PATH MUST stay local. Optional independent NAS attachment:
# MX_STATIC_NAS_PATH=/mnt/nas/mx-static
# MX_STATIC_NAS_VOLUME_ID=mx-static-nas-01
# Create .mx-static-volume-id with this exact value ON the confirmed mounted NFS.
