# GPU allocation is centralized in ../.env.gpu, not GPU_ID here.
TIER=fast-gpu
BIND=0.0.0.0
PORT=8710
# Conservative starting resource budget; benchmark before increasing.
CPU_LIMIT=16
MEM_LIMIT=16g
UVICORN_WORKERS=2
WORKERS_FAST=2
OMP_THREADS=4
ORT_INTRA=4
MODEL_SOURCE=modelscope
# Optional container-scoped download proxy. Never changes host proxy/VPN.
PROXY=
