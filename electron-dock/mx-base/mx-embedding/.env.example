# GPU allocation: ../.env.gpu (default GPU 1; OCR 2; display 3).
MX_EMBEDDING_BIND=127.0.0.1
MX_EMBEDDING_PORT=18210
MX_EMBEDDING_MODELS_PATH=/srv/mx-embedding/models
MX_EMBEDDING_DIMENSIONS=512
MX_EMBEDDING_MAX_LENGTH=2048
MX_EMBEDDING_MAX_BATCH=16
MX_EMBEDDING_MICRO_BATCH=4
# One GPU forward; bounded queue with reserved query admission (not GPU memory).
MX_EMBEDDING_MAX_PENDING=32
MX_EMBEDDING_QUERY_RESERVED=8
MX_EMBEDDING_QUERY_TIMEOUT=6
MX_EMBEDDING_BACKGROUND_TIMEOUT=45
MX_EMBEDDING_BATCH_WAIT_MS=2
MX_EMBEDDING_TOKEN_BUDGET=8192
MX_EMBEDDING_DTYPE=bfloat16
MX_EMBEDDING_GPU_FRACTION=0.25
MX_EMBEDDING_CPUS=4
MX_EMBEDDING_MEMORY=8g
# Optional reachable Hugging Face-compatible mirror (download only).
MX_EMBEDDING_HF_ENDPOINT=https://huggingface.co
# Applies to pip builds and model downloads; use a container-reachable address, not 127.0.0.1.
# Example: http://192.168.1.2:7788 (proxy must listen on that address).
MX_EMBEDDING_PROXY=
# For an offline Qwen snapshot placed under the models volume, use /models/<directory>.
# MX_EMBEDDING_MODEL_PATH=/models/Qwen3-Embedding-0.6B

MX_EMBEDDING_PIP_INDEX=https://pypi.org/simple
