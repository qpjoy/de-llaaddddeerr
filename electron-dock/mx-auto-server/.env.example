# Standard Kubernetes deploy needs no .env file. Copy this file only when an
# advanced override is required, and keep the resulting .env out of Git.

# Usually omit this. Kubernetes deploy generates and preserves it in the
# mx-auto Secret; `bash scripts/manage.sh admin-token` retrieves it when needed.
# MX_AUTO_ADMIN_TOKEN=<long-random-value>

# Optional in local memory mode. In Kubernetes the deploy script provisions an
# independent PostgreSQL instance and writes MX_AUTO_DATABASE_URL to a Secret.
# MX_AUTO_DATABASE_URL=postgres://mx_auto:password@127.0.0.1:5432/mx_auto

# Kubernetes deploy automatically discovers the canonical same-cluster Launcher
# Service. Only set these overrides for a custom or external Launcher endpoint.
# MX_AUTO_LAUNCHER_URL=http://launcher.example:18090
# MX_AUTO_LAUNCHER_AUDIENCE=mx-sdk

# Bounds opaque-token introspection at the mx-auto boundary. Invalid decisions
# are cached briefly; unique-token floods are capped per window and in flight.
# MX_AUTO_LAUNCHER_NEGATIVE_CACHE_TTL_MS=3000
# MX_AUTO_LAUNCHER_INTROSPECTION_WINDOW_MS=10000
# MX_AUTO_LAUNCHER_INTROSPECTION_MAX_STARTS=30
# MX_AUTO_LAUNCHER_INTROSPECTION_MAX_IN_FLIGHT=8
# MX_AUTO_LAUNCHER_INTROSPECTION_MAX_STARTS_PER_SOURCE=6
# MX_AUTO_LAUNCHER_INTROSPECTION_MAX_IN_FLIGHT_PER_SOURCE=2
# MX_AUTO_LAUNCHER_PASSWORD_LOGIN_WINDOW_MS=10000
# MX_AUTO_LAUNCHER_PASSWORD_LOGIN_MAX_STARTS=10
# MX_AUTO_LAUNCHER_PASSWORD_LOGIN_MAX_IN_FLIGHT=4
# MX_AUTO_LAUNCHER_PASSWORD_LOGIN_MAX_STARTS_PER_SOURCE=3
# MX_AUTO_LAUNCHER_PASSWORD_LOGIN_MAX_IN_FLIGHT_PER_SOURCE=1

# Optional URL used in generated links and to infer the session-cookie scheme.
# If blank, manage.sh deploy derives a best-effort NodePort URL; direct startup
# remains usable over HTTP and generates links from the incoming request host.
# MX_AUTO_PUBLIC_URL=http://node.example:30880

# Usually omit this. Blank PUBLIC_URL defaults to HTTP-compatible cookies;
# set false only when the deployment is intentionally HTTPS-only.
# MX_AUTO_INSECURE_COOKIES=false

# Usually omit this. Deploy builds a content-addressed image automatically for
# desktop, kind, and a same-host single-node kubeadm/containerd cluster. Set a
# pullable digest only when kubectl targets another host or a different runtime.
# MX_AUTO_IMAGE=registry.example/mx-auto-server@sha256:<64-hex-digest>

# Optional token used by runner Jobs to clone private test repositories.
# MX_AUTO_GIT_TOKEN=<private-repository-token>

# First-install values only. Once the database PVC exists, the live Secret is
# authoritative and ordinary deploy refuses a different or missing value.
# MX_AUTO_POSTGRES_PASSWORD=<first-install-override>
# MX_AUTO_SECRET_KEY=<first-install-override>

# Local development defaults.
# MX_AUTO_PORT=8790
# MX_AUTO_ARTIFACT_RETAIN_DAYS=30

# Kubernetes resource and artifact hard limits live together in
# deploy/k8s/internal/08-resource-policy.yaml. Do not raise only one value:
# Runner emptyDir, container limits, ResourceQuota and host-disk reserve must
# remain consistent. These optional overrides are mainly useful for local
# compatibility-boundary testing; the checked-in K8s ConfigMap is authoritative.
# MX_AUTO_MAX_CONCURRENT_SERVER_RUNS=1
# MX_AUTO_ARTIFACT_MAX_FILE_BYTES=536870912
# MX_AUTO_ARTIFACT_MAX_RUN_BYTES=2147483648
# MX_AUTO_ARTIFACT_MAX_FILES_PER_RUN=1000
# MX_AUTO_ARTIFACT_MAX_TOTAL_BYTES=21474836480
# MX_AUTO_ARTIFACT_MAX_TOTAL_ENTRIES=100000
# MX_AUTO_ARTIFACT_MIN_FREE_BYTES=5368709120
# MX_AUTO_ARTIFACT_MIN_FREE_INODES=10000

# Compass/Luopan onboarding. Electron resources are deliberately omitted unless
# a real QA Git repository or an explicit local Git test-pack path is supplied.
# MX_AUTO_COMPASS_REPO=https://github.com/mingxiinfo/po-frontend
# MX_AUTO_COMPASS_BRANCH=public
# MX_AUTO_COMPASS_FUNCTIONAL_CRON="0 2 * * *"
# MX_AUTO_COMPASS_QA_REPO=https://github.example/qa/compass-e2e.git
# A local test-pack must be the root of its own Git checkout and only works when
# that exact path is visible to the target runner. Prefer a shared Git remote.
# MX_AUTO_COMPASS_TEST_PACK=/absolute/path/to/git-checkout-root
# MX_AUTO_COMPASS_ELECTRON_BRANCH=main
# MX_AUTO_COMPASS_ELECTRON_WORKING_DIR=.
# Defaults to ["pnpm","test"] when omitted.
# MX_AUTO_COMPASS_ELECTRON_COMMAND_JSON=["pnpm","test:e2e"]
