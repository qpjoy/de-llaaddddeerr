# Only the MX Rig service consumes these. Never reuse a Launcher database/secret.
MX_RIG_HOST=127.0.0.1
MX_RIG_PORT=8791
MX_RIG_ADMIN_TOKEN=
MX_RIG_SECRET_KEY=
MX_RIG_STORE=postgres
MX_RIG_DATABASE_URL=
MX_RIG_STATE_DIR=
MX_RIG_ARTIFACTS_DIR=
MX_RIG_PUBLIC_URL=
MX_RIG_SELF_URL=http://127.0.0.1:8791
# Launcher public identity contract. Optional; without it use the Rig admin token.
MX_RIG_LAUNCHER_URL=
MX_RIG_LAUNCHER_AUDIENCE=mx-sdk
MX_RIG_DEFAULT_ROLE=viewer
MX_RIG_MODEL_API_KEY=
# Desktop bootstrap only; policy and model configuration still live in Internal.
MX_RIG_SERVER_URL=http://127.0.0.1:8791
