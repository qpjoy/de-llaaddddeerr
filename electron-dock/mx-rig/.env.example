# Rig service settings. Its database, admin token and encryption key are independent.
MX_RIG_HOST=127.0.0.1
MX_RIG_PORT=8791
MX_RIG_ADMIN_TOKEN=
MX_RIG_SECRET_KEY=
MX_RIG_STORE=postgres
MX_RIG_DATABASE_URL=
MX_RIG_STATE_DIR=
MX_RIG_ARTIFACTS_DIR=
MX_RIG_PUBLIC_URL=
MX_RIG_SELF_URL=http://127.0.0.1:8791
# Rig accounts are the default way in: the admin creates them in /test-center/
# 「成员」. Sessions are Rig-issued opaque tokens; lifetime in hours.
MX_RIG_SESSION_TTL_HOURS=12
# Optional Launcher federation. Leave empty to run Rig on its own accounts only.
MX_RIG_LAUNCHER_URL=
MX_RIG_LAUNCHER_AUDIENCE=mx-sdk
MX_RIG_DEFAULT_ROLE=viewer
MX_RIG_MODEL_API_KEY=
# Egress channel credentials, if a channel declares this variable name.
# Format user:password, read only in the server process, never entered in the UI.
MX_RIG_EGRESS_AUTH=
# Desktop bootstrap only; policy and model configuration still live in Internal.
MX_RIG_SERVER_URL=http://127.0.0.1:8791

# Management commands only: launcher plan/apply and release read this file.
# Shell MX_LAUNCHER_URL / MX_LAUNCHER_OPS_TOKEN override values in this file.
# The endpoint is discovered from the cluster when omitted.
# MX_LAUNCHER_URL=http://<Launcher-Internal-IP>:18090
# apply uses the EXISTING Launcher's MX_INTERNAL_OPS_TOKEN, not a new Rig token.
# Optional: provide via shell instead; this is not put in Rig's service Secret.
# MX_LAUNCHER_OPS_TOKEN='<existing Launcher Ops Token>'
