{
  "name": "@qpjoy/mx-rig",
  "version": "0.8.0",
  "private": true,
  "description": "MX Rig desktop agent workbench and independent Internal test control plane.",
  "author": "QPJoy",
  "type": "module",
  "bin": {
    "mx-rig": "bin/mx-rig.mjs",
    "mx-rig-mcp": "bin/mx-rig-mcp.mjs"
  },
  "workspaces": [
    "packages/test-platform"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "server": "node apps/server/index.mjs",
    "mcp": "node bin/mx-rig-mcp.mjs",
    "desktop": "electron apps/desktop/main.mjs",
    "test": "node scripts/test.mjs",
    "test:kernel": "node scripts/test.mjs kernel",
    "eval": "node evals/run.mjs",
    "eval:sensors": "node evals/sensors.mjs",
    "proving-ground": "node test-packs/proving-ground/server.mjs",
    "check": "node scripts/check.mjs",
    "browser:install": "node scripts/browser-install.mjs",
    "package": "node scripts/package.mjs",
    "setup": "node scripts/dev-mode.mjs local",
    "setup:npm": "node scripts/dev-mode.mjs npm",
    "dev-mode": "node scripts/dev-mode.mjs status",
    "make:mac": "npm run package -- --launcher --mac --all",
    "make:win": "npm run package -- --launcher --win --x64",
    "pack:cli": "node scripts/pack-cli.mjs",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "record:tours": "node scripts/record-tours.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "migrate": "node apps/server/migrate.mjs",
    "design": "node scripts/design-assets.mjs",
    "predev": "node scripts/design-assets.mjs",
    "predesktop": "node scripts/design-assets.mjs",
    "prepackage": "node scripts/design-assets.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@qpjoy/electron-core-mihomo": "0.1.2",
    "@qpjoy/electron-launcher": "^2.3.19",
    "openid-client": "6.8.8",
    "playwright": "1.58.2",
    "undici": "7.29.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "electron": "34.5.8",
    "electron-builder": "25.1.8",
    "prettier": "3.5.3"
  },
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "@qpjoy/electron-plugin-tunnel-engine-darwin-arm64": "0.1.6",
    "@qpjoy/electron-plugin-tunnel-engine-darwin-x64": "0.1.6",
    "@qpjoy/electron-plugin-tunnel-engine-linux-arm64": "0.1.6",
    "@qpjoy/electron-plugin-tunnel-engine-linux-x64": "0.1.6",
    "@qpjoy/electron-plugin-tunnel-engine-win32-x64": "0.1.6"
  }
}
