{
  "appId": "dev.qpjoy.mx-rig",
  "productName": "MX Rig",
  "npmRebuild": false,
  "directories": {
    "output": "dist"
  },
  "extraMetadata": {
    "main": "apps/desktop/main.mjs"
  },
  "files": [
    "apps/desktop/**",
    "apps/web/**",
    "packages/runtime/**",
    "packages/graph/**",
    "packages/contracts/**",
    "packages/test-platform/bin/mxt-runner.mjs",
    "bin/mx-rig.mjs",
    "apps/terminal/**",
    "scripts/design-assets.mjs",
    "package.json"
  ],
  "asarUnpack": [
    "node_modules/playwright*/**"
  ],
  "win": {
    "target": [
      "nsis"
    ],
    "requestedExecutionLevel": "asInvoker"
  },
  "mac": {
    "target": [
      "dmg"
    ],
    "category": "public.app-category.developer-tools",
    "extendInfo": {
      "NSAppleEventsUsageDescription": "MX Rig 在你允许后读取并操作你登记的原生应用窗口，用于自动化测试。"
    }
  },
  "linux": {
    "target": [
      "AppImage"
    ]
  }
}
