{
  "appId": "dev.qpjoy.mx-rig",
  "productName": "MX Rig",
  "artifactName": "MX-Rig-${version}-${os}-${arch}.${ext}",
  "npmRebuild": false,
  "directories": {
    "output": "dist"
  },
  "extraMetadata": {
    "main": "apps/desktop/main.mjs"
  },
  "files": [
    "apps/desktop/**",
    "apps/web/**",
    "packages/runtime/**",
    "packages/graph/**",
    "packages/contracts/**",
    "packages/test-platform/bin/mxt-runner.mjs",
    "bin/mx-rig.mjs",
    "apps/terminal/**",
    "scripts/design-assets.mjs",
    "test-packs/*/pack.json",
    "test-packs/*/README.md",
    "test-packs/*/reference/**",
    "test-packs/*/rig-specs/**",
    "test-packs/proving-ground/**",
    "!test-packs/**/node_modules/**",
    "!test-packs/**/artifacts/**",
    "package.json"
  ],
  "asarUnpack": [
    "node_modules/playwright*/**"
  ],
  "nsis": {
    "artifactName": "MX-Rig-${version}-${os}-${arch}.${ext}"
  },
  "win": {
    "target": [
      "nsis"
    ],
    "requestedExecutionLevel": "asInvoker"
  },
  "mac": {
    "target": [
      "dmg"
    ],
    "category": "public.app-category.developer-tools",
    "extendInfo": {
      "NSAppleEventsUsageDescription": "MX Rig 在你允许后读取并操作你登记的原生应用窗口，用于自动化测试。"
    }
  },
  "linux": {
    "target": [
      "AppImage"
    ]
  }
}
