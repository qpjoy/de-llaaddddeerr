{
  "name": "@qpjoy/compass-electron-test-pack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "External Playwright Electron acceptance pack for Compass/Luopan.",
  "scripts": {
    "test": "node scripts/run.mjs",
    "test:bootstrap": "node scripts/run.mjs --lane=bootstrap",
    "test:auth": "node scripts/run.mjs --lane=auth",
    "check": "node --check scripts/run.mjs && node --test scripts/*.test.mjs && tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.21",
    "playwright": "1.63.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
