# Rig's public entrance on the Internal Nginx (docs/25 §11). An example to
# adopt into de-mingxi's internal-nginx configuration, beside Hub and Pay:
# the Domestic gateway terminates TLS for rig.minsight-ai.com and forwards
# over WireGuard to 10.88.88.88:80. Replace the upstream with the address
# `scripts/manage.sh deploy` prints for the Rig service.

upstream mx_rig_server {
  server 10.0.0.5:30891;   # the Rig service (NodePort); from manage.sh deploy
  keepalive 8;
}

server {
  listen 10.88.88.88:80;
  server_name rig.minsight-ai.com;

  # Only the Domestic gateway's WireGuard peer.
  allow 10.88.0.1;
  deny all;

  access_log off;
  client_max_body_size 16m;

  # What Rig needs from a proxy: the public Host, the browser's Origin and
  # cookies, HTTP/1.1, and no buffering of streamed answers.
  proxy_http_version 1.1;
  proxy_set_header Host rig.minsight-ai.com;
  proxy_set_header Connection "";
  proxy_set_header X-Forwarded-Proto https;
  proxy_buffering off;
  proxy_read_timeout 120s;

  # Password sign-in, machine and internal routes are not public.
  location = /api/rig/v1/login        { return 404; }
  location = /api/rig/v1/native-login { return 404; }
  location = /api/v1/auth/login       { return 404; }
  location = /api/v1/auth/password    { return 404; }
  location ^~ /api/rig/v1/station/    { return 404; }

  location = /            { proxy_pass http://mx_rig_server; }
  location = /rig         { proxy_pass http://mx_rig_server; }
  location ^~ /rig/        { proxy_pass http://mx_rig_server; }
  location ^~ /auth/sso/     { proxy_pass http://mx_rig_server; }
  location ^~ /auth/desktop/ { proxy_pass http://mx_rig_server; }
  location ^~ /api/rig/v1/ { proxy_pass http://mx_rig_server; }
  location ^~ /api/v1/     { proxy_pass http://mx_rig_server; }

  # Everything else (runners, webhooks, health, the old console) stays inside.
  location / { return 404; }
}
