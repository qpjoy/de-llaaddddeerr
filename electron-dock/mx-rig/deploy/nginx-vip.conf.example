# Install inside nginx's http context. Use the VIP from `launcher plan`.
# 10.88.100.6 is the allocation confirmed for this Internal deployment.
# Keep the upstream service address in Launcher Admin's Caddy route registry.
map $http_upgrade $mx_rig_vip_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name 10.88.100.6;

    location / {
        proxy_pass http://127.0.0.1:8008;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $mx_rig_vip_connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
}
