{
  "name": "@qpjoy/electron-launcher",
  "version": "2.3.11",
  "description": "Product-facing Electron Launcher client for MX Launcher release, update, rollout, AppCenter, and network integration.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wireguard": {
      "types": "./dist/wireguard.d.ts",
      "import": "./dist/wireguard.js"
    },
    "./system-domain-proxy": {
      "types": "./dist/system-domain-proxy.d.ts",
      "import": "./dist/system-domain-proxy.js"
    },
    "./network-diagnostics": {
      "types": "./dist/network-diagnostics.d.ts",
      "import": "./dist/network-diagnostics.js"
    },
    "./network-ownership-registry": {
      "types": "./dist/network-ownership-registry.d.ts",
      "import": "./dist/network-ownership-registry.js"
    },
    "./network-mode-events": {
      "types": "./dist/network-mode-events.d.ts",
      "import": "./dist/network-mode-events.js"
    },
    "./standalone-data-plane": {
      "types": "./dist/standalone-data-plane.d.ts",
      "import": "./dist/standalone-data-plane.js"
    },
    "./release-updater": {
      "types": "./dist/release-updater.d.ts",
      "import": "./dist/release-updater.js"
    },
    "./local-ports": {
      "types": "./dist/local-ports.d.ts",
      "import": "./dist/local-ports.js"
    },
    "./oversea": {
      "types": "./dist/oversea.d.ts",
      "import": "./dist/oversea.js"
    },
    "./release-update-executor": {
      "types": "./dist/release-update-executor.d.ts",
      "import": "./dist/release-update-executor.js"
    },
    "./bootstrap": {
      "types": "./dist/bootstrap.d.ts",
      "import": "./dist/bootstrap.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke:dns-relay": "pnpm build && node scripts/dns-relay-protocol-smoke.mjs",
    "smoke:network-diagnostics": "pnpm build && node scripts/network-diagnostics-smoke.mjs",
    "smoke:standalone-ownership": "pnpm build && node scripts/standalone-ownership-concurrency-smoke.mjs",
    "smoke:system-domain-proxy-windows": "pnpm build && node scripts/system-domain-proxy-windows-smoke.mjs",
    "smoke:wireguard-windows-nrpt": "pnpm build && node scripts/wireguard-windows-nrpt-smoke.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@qpjoy/electron-core-wireguard": "workspace:^",
    "@qpjoy/mx-launcher-core": "workspace:^",
    "@qpjoy/mx-launcher-embed-sdk": "workspace:^",
    "@qpjoy/mx-launcher-standalone": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3"
  }
}
