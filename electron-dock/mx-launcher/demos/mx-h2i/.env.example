MX_H2I_BOOTSTRAP_BASE_URL=https://h2i.minsight-ai.com
MX_H2I_HOST_RESOLVE=h2i.minsight-ai.com=116.62.51.154
MX_H2I_BOOTSTRAP_RESOLVE_MODE=env-first
MX_H2I_DOMESTIC_RELAY_HOST=116.62.51.154
MX_H2I_INTERNAL_BASE_URL=http://10.88.88.88:18090
MX_H2I_SPLIT_DNS_DOMAINS=mx.cn,mxinfo-inc.cn,internal.mx,corp.mx,h2i.mx
# 公网 bootstrap 域名不进入 split DNS；Host Resolve 仍保留原 SNI/Host 和证书校验。
# MX_H2I_BOOTSTRAP_DNS_SERVERS=223.5.5.5,119.29.29.29
# env-first：先用 MX_H2I_HOST_RESOLVE 指到 Domestic 公网 IP，失败再走公网 DNS
# dns-first：先走 MX_H2I_BOOTSTRAP_DNS_SERVERS 指定 DNS，未配置时走系统 DNS，失败再走 .env
# env-only：只走 .env 指定 IP，适合隔离诊断
# dns-only：只走 MX_H2I_BOOTSTRAP_DNS_SERVERS/系统 DNS，适合正式 DNS 完成后
