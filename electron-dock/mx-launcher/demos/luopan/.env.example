# Luopan demo environment (copy to .env)
#
# Load order (first hit wins per key; real env vars always win over files):
#   1. process env
#   2. <userData>/.env            (per-machine override, survives updates)
#   3. <app Resources>/.env       (this file, shipped inside the packaged app)
#   4. project .env               (dev)
#
# Product ID is the stable identity created in Admin/AppCenter. Other
# standalone demos should copy this file and change only the product ID and
# bootstrap entrance; VIP/CIDR/capabilities come from ProductNetwork.
LUOPAN_PRODUCT_ID=luopan

# Bootstrap entrances probed IN ORDER before the WireGuard tunnel exists.
# The in-tunnel VIP is resolved from ProductNetwork.serviceVip and is NOT
# reachable on first connect — only anonymous bootstrap/enroll traffic goes
# through the first healthy URL. User credentials and bearer tokens are sent
# only after network-ready, through the in-tunnel VIP.
# Comma/space separated; scheme optional (http:// assumed).
#
# Prefer the public IP for fastest first connect and keep the canonical HTTPS
# domain as fallback. If you use a LAN/local bootstrap for development, put it
# first; Luopan will not reorder private/bootstrap-local candidates.
LUOPAN_BOOTSTRAP_URLS=http://116.62.51.154:18090,https://h2i.minsight-ai.com

# Optional dev override. Normally Luopan resolves this from
# ProductNetwork.serviceVip, e.g. luopan -> http://10.88.100.3:18090.
# A different value must never point at an MX-H2I/foundation address unless
# you intentionally run SDK test mode against a local control plane.
# LUOPAN_LAUNCHER_BASE_URL=http://10.88.100.3:18090

# Optional one-time V1 -> V2 identity migration bridge. When an account is
# absent from V2 User Center, Luopan validates the same credentials against
# this legacy HDO API, imports the identity through the in-tunnel VIP as an
# ordinary mx-user, then retries V2 login. Leave unset after migration is
# complete. Prefer HTTPS; HTTP is only for the current legacy deployment.
# LUOPAN_LEGACY_HDO_BASE_URL=http://116.62.51.154:8080

# Optional: comma-separated Oversea site preference. Leave unset to let
# Internal choose the ProductNetwork/default site (normally oversea-main).
# No subscription URL, Hysteria2 secret, or user token belongs in this file.
# LUOPAN_OVERSEA_SITE_IDS=oversea-main

# Optional: device label shown in Admin lease records.
# LUOPAN_DEVICE_LABEL=Luopan Quasar Demo

# Dev only — never in release builds (HANDOFF 红线):
# LUOPAN_SDK_TEST_MODE=1
