# Public Launcher entrances used only before the product route is ready.
# Comma-separated; do not put credentials in these URLs.
MX_AUTOTEST_BOOTSTRAP_URLS=https://h2i.minsight-ai.com

# Launcher/User Center service exposed behind this product's registered VIP.
MX_AUTOTEST_INTERNAL_PORT=18090

# mx-auto-server API. Both HTTP and HTTPS are accepted; use HTTPS whenever the
# network is not trusted because the desktop sends its User Center bearer token.
MX_AUTOTEST_SERVER_URL=http://127.0.0.1:8790

MX_AUTOTEST_DEVICE_LABEL=MX AutoTest Desktop

# Development only. A packaged build must use a registered ProductNetwork.
MX_AUTOTEST_SDK_TEST_MODE=0
