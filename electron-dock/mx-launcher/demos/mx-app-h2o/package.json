    "@qpjoy/electron-plugin-tunnel-engine-darwin-arm64": "workspace:^",
    "@qpjoy/electron-plugin-tunnel-engine-darwin-x64": "workspace:^",
    "@qpjoy/electron-plugin-tunnel-engine-linux-arm64": "workspace:^",
    "@qpjoy/electron-plugin-tunnel-engine-linux-x64": "workspace:^",
    "@qpjoy/electron-plugin-tunnel-engine-win32-x64": "workspace:^"
  },
  "devDependencies": {
    "electron": "^34.0.0"
  }
