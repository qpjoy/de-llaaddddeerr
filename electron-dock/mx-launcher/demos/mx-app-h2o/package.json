{
  "name": "@qpjoy/electron-launcher-app-h2o",
  "productName": "MX-H2I H2O",
  "version": "2.3.15",
  "private": false,
  "author": "QPJoy",
  "description": "Home To Oversea embed network plugin for MX-H2I AppCenter.",
  "license": "UNLICENSED",
  "main": "src/main.cjs",
  "files": [
    "README.md",
    "package.json",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run check",
    "dev": "electron .",
    "start": "pnpm dev",
