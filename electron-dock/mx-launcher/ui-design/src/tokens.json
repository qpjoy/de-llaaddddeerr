{
  "meta": {
    "name": "Neon Void",
    "packageName": "@qpjoy/ui-design-neon-void",
    "description": "Dark tool UI with cyan primary actions, quiet blue-gray panels, compact controls, and precise state feedback."
  },
  "color": {
