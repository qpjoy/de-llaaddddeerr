{
  "name": "@qpjoy/tunnel-cli",
  "version": "2.0.1",
  "description": "Global QPJoy Tunnel CLI for mihomo-client, legacy HDO, and MX H2I V2 enrollment.",
  "private": false,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "qp-tunnel-cli": "dist/index.js"
  },
  "files": [
    "dist",
    "resources",
    "scripts",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@qpjoy/mx-launcher-standalone": "2.3.15",
    "@qpjoy/electron-core-wireguard": "^2.3.15"
  },
  "devDependencies": {
    "@types/node": "^22.10.7"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "sync:mx-launcher-fallback": "node scripts/sync-mx-launcher-fallback.mjs",
    "test": "pnpm build && node --test tests/*.test.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  }
}