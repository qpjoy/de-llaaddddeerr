TZ=Asia/Shanghai

# Internal Admin overwrites this with the Oversea slot public IP/host.
HY2_SERVER_HOST=203.0.113.10
# Fixed UDP port advertised to H endpoints.
HY2_SERVER_PORTS=51288
HY2_HOP_INTERVAL_SECONDS=0
HY2_STACK_SUBNET=10.254.0.0/24
HY2_STACK_GATEWAY=10.254.0.1
HY2_USERS=user01,user02,user03
HY2_PEER_DNS=223.5.5.5,119.29.29.29,1.1.1.1,8.8.8.8
# Mihomo is Internal-managed. In the default push-only mode, Oversea does not
# call Internal directly; Internal pushes account/runtime state over SSH.
HY2_INTERNAL_MIHOMO_BASE_URL=
HY2_INTERNAL_CALLBACK_MODE=push-only
HY2_INTERNAL_CALLBACK_BASE_URL=
HY2_INTERNAL_SUBSCRIPTION_STORE=config-center
HY2_MIHOMO_ROUTING_MODE=cn-direct
HY2_RESERVED_INTERNAL_CIDRS=10.88.0.0/16,10.89.0.0/16,10.90.0.0/16,10.91.0.0/16
HY2_DOMESTIC_GATEWAY_IP=10.88.0.1
HY2_TLS_SERVER_NAME=203.0.113.10
HY2_TLS_SELF_SIGNED_DAYS=3650
HY2_TLS_SKIP_CERT_VERIFY=true
HY2_TLS_FINGERPRINT=
HY2_SERVER_BANDWIDTH_DOWN='30 Mbps'
HY2_SERVER_BANDWIDTH_UP='30 Mbps'
HY2_DEFAULT_DOWN='30 Mbps'
HY2_DEFAULT_UP='30 Mbps'
HY2_MASQUERADE_URL=https://news.ycombinator.com/
HY2_OBFS_PASSWORD=

HY2_EXPORT_SITE_ADDRESS=:8080
HY2_EXPORT_BASE_URL=http://203.0.113.10:3434
HY2_EXPORT_FALLBACK_PORT=3434
HY2_EXPORT_USER=download
# If empty, manage.sh generates a random password and stores only the bcrypt hash.
HY2_EXPORT_PASSWORD_HASH=
