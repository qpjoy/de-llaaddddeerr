NODE_ENV=production
HOST=0.0.0.0
PORT=18090
LOG_LEVEL=info

MX_ENVIRONMENT=shadow
MX_SITE_ID=internal-main
MX_SITE_ROLE=internal
# Leave empty to use defaults for the site role.
MX_ENABLED_MODULES=
MX_PUBLIC_BASE_URL=http://10.88.88.88:18090
MX_INTERNAL_BASE_URL=http://192.168.1.4:18090

# Phase 1 starts with the memory store so the parallel backend can be tested
# without migrations. Keep the Postgres URL ready for the next store driver.
INTERNAL_STORE_DRIVER=memory
DATABASE_URL=postgres://mx_internal:mx_internal@postgres:5432/mx_internal_shadow

OBSERVABILITY_SINKS=[{"kind":"otlp-http","environment":"shadow","url":"http://otel-collector:4318/v1/logs"}]
RUNNER_DRY_RUN_DEFAULT=1

# Release Center artifact storage.
# Local dev can copy this file to server/.env. Production should prefer k8s Secret
# or Config Center materialization so credentials never ship with the app.
MX_RELEASE_ARTIFACT_STORAGE=auto
MX_RELEASE_ARTIFACT_STORE_DIR=artifacts/release-center
MX_RELEASE_ARTIFACT_MAX_BYTES=2147483648

# OSS is selected automatically when all required MX_RELEASE_OSS_* values exist.
MX_RELEASE_OSS_ENDPOINT=
MX_RELEASE_OSS_BUCKET=
MX_RELEASE_OSS_ACCESS_KEY_ID=
MX_RELEASE_OSS_ACCESS_KEY_SECRET=
# Optional when ACCESS_KEY_ID / ACCESS_KEY_SECRET are temporary STS credentials.
MX_RELEASE_OSS_SECURITY_TOKEN=
MX_RELEASE_OSS_PREFIX=mx-h2i/releases
# Leave empty for private buckets. The server will redirect downloads to signed OSS URLs.
# Only set this for public-read buckets or a CDN/domain that can serve the objects directly.
MX_RELEASE_OSS_PUBLIC_BASE_URL=
MX_RELEASE_OSS_SIGNED_URL_TTL_SECONDS=3600
