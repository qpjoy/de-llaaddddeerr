NODE_ENV=production
HOST=0.0.0.0
PORT=18090
LOG_LEVEL=info

MX_ENVIRONMENT=shadow
MX_SITE_ID=internal-main
MX_SITE_ROLE=internal
# Leave empty to use defaults for the site role.
MX_ENABLED_MODULES=
MX_PUBLIC_BASE_URL=http://10.88.88.88:18090
MX_INTERNAL_BASE_URL=http://192.168.1.4:18090

# Phase 1 starts with the memory store so the parallel backend can be tested
# without migrations. Keep the Postgres URL ready for the next store driver.
INTERNAL_STORE_DRIVER=memory
DATABASE_URL=postgres://mx_internal:mx_internal@postgres:5432/mx_internal_shadow

OBSERVABILITY_SINKS=[{"kind":"otlp-http","environment":"shadow","url":"http://otel-collector:4318/v1/logs"}]
RUNNER_DRY_RUN_DEFAULT=1

# Internal K8s Secret ensure.
# Copy only the values that this host actually needs to server/.env (already
# gitignored), then chmod 600 server/.env. On a healthy existing cluster all
# credential values below may be omitted: deploy preserves the existing K8s
# Secrets and validates the active managed contracts. A process environment
# value takes precedence over the same key in this file.
#
# DB identity/credentials are used to bootstrap a missing mx-launcher-db Secret.
# On an existing database they must match the current Secret; deploy refuses to
# rotate a live PostgreSQL identity/password implicitly.
# PG_USER=mx_internal
# PG_PASSWORD=<RANDOM_DATABASE_PASSWORD>
# PG_DB=mx_internal_shadow
# Keep the original three values here before kubeadm reinit; the reinit command
# refuses to reset etcd unless all three recovery values are explicitly present.
# DATABASE_HOST is normally discovered and maintained by deploy.
#
# Omit MX_INTERNAL_OPS_TOKEN to preserve the current value, or to generate a
# random 32-byte token on the first deployment.
# MX_INTERNAL_OPS_TOKEN=<RANDOM_SECRET_WITH_AT_LEAST_32_CHARACTERS>
#
# Omit all three on an existing healthy cluster. Initial Feishu setup needs all
# three; a later intentional rotation may set one and preserve the other two.
# MX_FEISHU_APP_ID=<FEISHU_APP_ID>
# MX_FEISHU_APP_SECRET=<FEISHU_APP_SECRET>
# MX_FEISHU_ALLOWED_TENANT_KEYS=<TENANT_KEY_1>[,<TENANT_KEY_2>]
#
# Deprecated one-release migration input only. New application credentials are
# issued by AppCenter/SDK APIs, stored as hashes in PostgreSQL, and returned in
# plaintext once for the application's CI/Vault. Normal deploys omit this value.
# When migrating old accounts, this must still be the complete legacy map. After
# verification, remove this value and explicitly delete the legacy K8s Secret;
# omission alone intentionally preserves an existing Secret.
# MX_SDK_SERVICE_ACCOUNT_SECRETS_JSON='{"svc_legacy":"<EXISTING_SECRET_WITH_AT_LEAST_32_CHARACTERS>"}'

# Registry used only while building the Internal server image. Corepack and
# pnpm install must use the same reachable endpoint.
MX_SHADOW_NPM_REGISTRY=https://registry.npmmirror.com
# For a host-only proxy, use host network plus the proxy's loopback URL.
# MX_SHADOW_BUILD_NETWORK=host
# BUILD_CONTAINER_HTTP_PROXY=http://127.0.0.1:7788
# BUILD_CONTAINER_HTTPS_PROXY=http://127.0.0.1:7788
# BUILD_CONTAINER_NO_PROXY=localhost,127.0.0.1,::1,.svc,.cluster.local

# Release Center artifact storage.
# Local dev can copy this file to server/.env. Production should prefer k8s Secret
# or Config Center materialization so credentials never ship with the app.
MX_RELEASE_ARTIFACT_STORAGE=auto
MX_RELEASE_ARTIFACT_STORE_DIR=artifacts/release-center
MX_RELEASE_ARTIFACT_MAX_BYTES=2147483648

# OSS is selected automatically when all required MX_RELEASE_OSS_* values exist.
# env: declaratively merge explicit values with the existing K8s Secret. Empty
# SECURITY_TOKEN/PUBLIC_BASE_URL values explicitly clear those two optional keys.
# external: wait for KMS/Vault/ExternalSecret to materialize and validate mx-release-oss.
# auto: non-destructively merge non-empty values; blank placeholders and omitted keys preserve.
# disabled: skip Secret management without deleting an existing cluster Secret.
MX_RELEASE_OSS_SECRET_SOURCE=auto
# Existing clusters normally omit all MX_RELEASE_OSS_* credential values.
# Set the required four values only when initially creating or intentionally
# updating mx-release-oss.
# MX_RELEASE_OSS_ENDPOINT=<OSS_ENDPOINT>
# MX_RELEASE_OSS_BUCKET=<OSS_BUCKET>
# MX_RELEASE_OSS_ACCESS_KEY_ID=<OSS_ACCESS_KEY_ID>
# MX_RELEASE_OSS_ACCESS_KEY_SECRET=<OSS_ACCESS_KEY_SECRET>
# Optional when ACCESS_KEY_ID / ACCESS_KEY_SECRET are temporary STS credentials.
# MX_RELEASE_OSS_SECURITY_TOKEN=<OSS_SECURITY_TOKEN>
# MX_RELEASE_OSS_PREFIX=mx-h2i/releases
# Leave empty for private buckets. The server will redirect downloads to signed OSS URLs.
# Only set this for public-read buckets or a CDN/domain that can serve the objects directly.
# MX_RELEASE_OSS_PUBLIC_BASE_URL=<PUBLIC_BASE_URL>
# MX_RELEASE_OSS_SIGNED_URL_TTL_SECONDS=3600
