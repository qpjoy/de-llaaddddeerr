# Install on the pinned Harbor K8s node; Harbor hostPort binds loopback only.
server {
    listen 80;
    server_name harbor.example.com;
    client_max_body_size 10m;
    location ^~ /internal/ { return 404; }
    location ^~ /demos/ { return 404; }
    # Machine clients keep the Hub protocol, key, quotas and idempotency semantics.
    # No browser cookies or Admin routes cross this compatibility endpoint.
    location ^~ /api/v1/ {
        proxy_pass http://127.0.0.1:18150;
        proxy_set_header Host $host;
        proxy_set_header Cookie "";
        proxy_hide_header Set-Cookie;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_read_timeout 180s;
    }
    location ^~ /auth/sso/ {
        proxy_pass http://127.0.0.1:18220;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        access_log off;
    }
    location / {
        proxy_pass http://127.0.0.1:18220;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
}
