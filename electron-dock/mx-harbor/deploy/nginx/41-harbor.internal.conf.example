# Install on the pinned Harbor K8s node via internal-harbor-install.
# Harbor exposes only a loopback hostPort; Hub Public uses hostNetwork port 18150.
server {
    listen 80;
    listen [::]:80;
    server_name harbor.minsight-ai.com;
    allow 10.88.0.1;
    allow 127.0.0.1;
    allow ::1;
    deny all;
    client_max_body_size 10m;
    access_log off;
    proxy_http_version 1.1;
    proxy_set_header Host harbor.minsight-ai.com;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host harbor.minsight-ai.com;
    proxy_set_header X-Forwarded-Port 443;
    proxy_set_header X-Real-IP $http_x_real_ip;
    proxy_set_header X-Forwarded-For $http_x_real_ip;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 180s;
    proxy_send_timeout 180s;
    proxy_next_upstream off;
    proxy_redirect off;

    location ~ ^/(internal|demos|admin)(/|$) { return 404; }
    # Preserve machine API Authorization and idempotency headers, but no cookies
    # or internal credentials; authorization/quota/billing remain in Hub Public.
    location ^~ /api/v1/ {
        proxy_pass http://127.0.0.1:18150;
        proxy_set_header Host harbor.minsight-ai.com;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host harbor.minsight-ai.com;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Real-IP $http_x_real_ip;
        proxy_set_header X-Forwarded-For $http_x_real_ip;
        proxy_set_header Connection "";
        proxy_set_header Cookie "";
        proxy_set_header X-Mx-Insight-Admin-Token "";
        proxy_set_header X-Mx-Harbor-Gateway "";
        proxy_hide_header Set-Cookie;
        proxy_buffering off;
    }
    location / { proxy_pass http://127.0.0.1:18220; }
}
