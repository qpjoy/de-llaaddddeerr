{
  "$schema": "../schemas/electron-game.registry.schema.json",
  "version": 1,
  "games": [
    {
      "id": "qpjoy.electron-game-suduku",
      "packageName": "@qpjoy/electron-game-suduku",
      "displayName": "Suduku",
      "version": "0.1.1",
      "category": "puzzle",
      "description": "A local-first Sudoku game with 7x7 and 9x9 modes, completion scoring, and marketplace SQLite history.",
      "entry": {
        "electronMain": "src/main.js",
        "renderer": "renderer/index.html"
      },
      "modes": [
        {
          "id": "7x7",
          "label": "7x7",
          "gridSize": 7
        },
        {
          "id": "9x9",
          "label": "9x9",
          "gridSize": 9
        }
      ],
      "install": {
        "source": "npm",
        "packageName": "@qpjoy/electron-game-suduku"
      }
    }
  ]
}
