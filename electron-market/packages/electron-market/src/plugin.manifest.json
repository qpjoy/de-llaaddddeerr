{
  "id": "qpjoy.electron-market",
  "name": "QPJoy Marketplace",
  "version": "0.4.2",
  "author": "qpjoy",
  "description": "The plugin marketplace and host runtime. Manages other plugins.",
  "engines": {
    "electronMarket": ">=0.2.0",
    "electron": ">=28"
  },
  "permissions": [
    "fs:userData",
    "net:listen:23455",
    "net:fetch:plugins.qpjoy.dev",
    "ipc:cross",
    "ui:adminPanel"
  ],
  "activationEvents": [
    "onStartup"
  ],
  "contributes": {
    "adminPanel": {
      "url": "http://127.0.0.1:23455",
      "label": "Plugin Market"
    }
  }
}
